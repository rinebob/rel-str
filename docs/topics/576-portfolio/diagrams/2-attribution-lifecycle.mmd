flowchart TD
    T["Order ticket<br/>bucketId (optional — user picks)"] --> SUB["Submit order<br/>(warn-not-block drift check only)"]
    SUB --> FILL["Fill — per leg / execution"]
    FILL --> RES{"bucketId set AND bucket<br/>still exists + ACTIVE<br/>in the same account?<br/>(verified in the txn)"}
    RES -->|"yes"| SEED["Create PositionAttribution per leg<br/>{account}_{instrumentId} → bucketId<br/>history: [null → bucket, at]<br/>linkKey = parent orderId (multi-leg)"]
    RES -->|"no / stale / retired"| NONE["No attribution doc written"]
    NONE --> UNS["Position appears in<br/>UNASSIGNED row"]
    UNS --> POST["Post-hoc assign<br/>(Positions tab)"]
    POST --> EVT["Create attribution doc OR<br/>append {from → to, at}"]
    SEED --> STATS["Next refresh:<br/>bucket owns instrument's<br/>FULL history"]
    EVT --> STATS
    MOVE["Move between buckets<br/>(mis-tag correction)"] --> ATOMIC{"leg shares a linkKey<br/>with other legs?"}
    ATOMIC -->|"yes — spread"| EVTALL["Append {from → to}<br/>to ALL linked legs atomically"]
    ATOMIC -->|"no — single leg"| EVT
    EVTALL --> STATS
