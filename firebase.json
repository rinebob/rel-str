{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9100
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5002
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8086
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9200
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4410
    },
    "ui": {
      "enabled": true,
      "port": 4010
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4510
    },
    "singleProjectMode": true
  }
}
