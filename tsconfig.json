/* @topic #114 — Options Strategy Engine — Hybrid Quote Provider */
/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@rh-agent-mcp/contracts": ["shared/robinhood-mcp-contracts.ts"],
      "@rh-agent-mcp/utils": ["shared/robinhood-mcp-utils.ts"],
      "@options-contract/contracts": ["shared/options-contract-contracts.ts"],
      "@options/common": ["shared/options-common.ts"],
      "@common": ["shared/common.ts"],
      "@options-strategy-engine/contracts": ["shared/options-strategy-engine-contracts.ts"],
      "@options-strategy-engine/id": ["shared/strategy-instance-id.ts"],
      "@spread/contracts": ["shared/spread-contracts.ts"]
    },
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "exclude": ["functions", "**/*.spec.ts"],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
