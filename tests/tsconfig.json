{
  "extends": "../functions/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "typeRoots": ["../node_modules/@types", "./node_modules/@types"],
    "types": ["jest", "node"],
    "rootDir": "..",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "functions/**/*.test.ts",
    "functions/**/*.spec.ts",
    "../functions/src"
  ],
  "exclude": []
}
