// ST Trigger Bands — Thread #862 (Topic 261, indicator-lib), task #878
// Body-based 3-bar Donchian bands with expansion-gated pullback arming and
// breakout-event dots. Pine v6 — all sibling rb-st-* scripts are v6; the
// migration also drops v5's bool-na semantics this port no longer needs.
//
// Contract (parity with functions/src/indicators/st-trigger-bands.ts +
// functions/src/st-cloud-function/indicator-computation.ts):
//   Bands — highest/lowest of the bar BODY (max/min of open,close) over
//           `length` bars; na until the 3-bar window fills (engine emits
//           null for the first length-1 bars; wicks never widen the bands).
//   Pullback flag — long: upper <= upper[1]; short: lower >= lower[1].
//           Flags drive band colour only — they are a warning, not a dot.
//   Arming — a pullback may only become armed STATE after the band has
//           expanded since the last same-side breakout (the flat bar right
//           after a breakout is not a fresh setup). Reset-before-expansion
//           ordering: the breakout bar's own expansion doesn't count.
//   Breakout — armed state + band precondition (two bars ago already past
//           the one-bar-ago band) + body crosses the band. Dots are
//           breakout bars ONLY, anchored to the envelope ∓ 1.5*ATR — never
//           inside the channel (backend emits the same anchor, not wicks).
//   Both sides run independent state machines; a long breakout does not
//   reset short expansion state.
//
// Warm-up: bands are na until the window fills. In Pine v6 bools cannot be
// na — comparisons and ta.crossover/crossunder on na history already yield
// false, which is EXACTLY the engine's null-comparison semantics, so no
// nz() needed (v6 removed the bool overload anyway — it won't compile).

//@version=6
indicator(title="ST Trigger Bands", shorttitle="ST-TB", overlay=true, timeframe="", timeframe_gaps=true)

//////////////////////// INPUTS //////////////////////////

// Parity with the engine holds at the default length=3 — the input exists
// for experimentation; changing it silently diverges from the backend.
length       = input.int(3, minval = 1)
longColor    = input.color(color.blue,   "Long color")
shortColor   = input.color(color.yellow, "Short color")
neutralColor = input.color(color.white,  "Neutral band color")

//////////////////////// BANDS + STATE //////////////////////////

bodyHigh = open < close ? close : open
bodyLow  = open > close ? close : open

// Bands computed unconditionally (ta.* behind a ternary gets a history-
// consistency warning); na until the 3-bar window fills — engine parity.
upperRaw = ta.highest(bodyHigh, length)
lowerRaw = ta.lowest(bodyLow,  length)
upper = bar_index >= length - 1 ? upperRaw : float(na)
lower = bar_index >= length - 1 ? lowerRaw : float(na)

// Crosses hoisted to global scope — `and` short-circuits in Pine, so a
// ta.* call behind a condition wouldn't execute every bar (inconsistent
// history). v6 bools can't be na: these are false while bands warm up.
crossUp = ta.crossover(bodyHigh, upper[1])
crossDn = ta.crossunder(bodyLow, lower[1])

// Long side: pullback flag, breakout event, expansion latch, armed state.
longPullback = upper <= upper[1]
var bool longExpanded = false
var bool longPullbackState = false
longBreakout = upper[2] >= upper[1] and crossUp and longPullbackState[1]
longExpanded := longBreakout ? false : upper > upper[1] ? true : longExpanded[1]
longPullbackState := longBreakout ? false : longPullback and longExpanded ? true : longPullbackState[1]

// Short side — mirrored.
shortPullback = lower >= lower[1]
var bool shortExpanded = false
var bool shortPullbackState = false
shortBreakout = lower[2] <= lower[1] and crossDn and shortPullbackState[1]
shortExpanded := shortBreakout ? false : lower < lower[1] ? true : shortExpanded[1]
shortPullbackState := shortBreakout ? false : shortPullback and shortExpanded ? true : shortPullbackState[1]

//////////////////////// PLOTS //////////////////////////

// Band colour: pullback flag paints the band in the OPPOSITE side's colour
// (upper→shortColor, lower→longColor, as the original); a breakout bar paints
// its own side's colour; neutral otherwise.
upperColor = longPullback  ? shortColor : longBreakout  ? longColor  : neutralColor
lowerColor = shortPullback ? longColor  : shortBreakout ? shortColor : neutralColor

plot(upper, "Upper", color = upperColor, style = plot.style_stepline, linewidth = 3, force_overlay = true)
plot(lower, "Lower", color = lowerColor, style = plot.style_stepline, linewidth = 3, force_overlay = true)

// Breakout dots — breakout bars only, anchored to the envelope ∓ 1.5*ATR.
// KNOWN DIVERGENCE: computeATR() seeds atr[0..13] with the hindsight
// mean(tr[0..13]) — the engine emits dots for breakouts as early as bar 3;
// ta.atr(14) is na through index 12 (first valid ATR at index 13, the 14th
// bar) and Pine cannot replicate the lookahead — a breakout on bars 3-12
// draws no dot here (rare; <14-bar charts get none).
// Realtime bar: values repaint intrabar — the engine only sees closed bars.
dotOffset = ta.atr(14) * 1.5
plot(longBreakout  ? lower - dotOffset : na, "long breakout",  color = longColor,  style = plot.style_cross, linewidth = 4, force_overlay = true)
plot(shortBreakout ? upper + dotOffset : na, "short breakout", color = shortColor, style = plot.style_cross, linewidth = 4, force_overlay = true)
