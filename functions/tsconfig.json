/*
 */
{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@robinhood-mcp/contracts": ["../shared/robinhood-mcp-contracts.ts"],
      "@robinhood-mcp/utils": ["../shared/robinhood-mcp-utils.ts"],
      "@options-contract/contracts": ["../shared/options-contract-contracts.ts"],
      "@options/common": ["../shared/options-common.ts"],
      "@common": ["../shared/common.ts"],
      "@spread/contracts": ["../shared/spread-contracts.ts"],
      "@options-strategy-engine/contracts": ["../shared/options-strategy-engine-contracts.ts"],
      "@paper-trading/contracts": ["../shared/paper-trading-contracts.ts"],
      "@paper-trading/ids": ["../shared/paper-trading-ids.ts"],
      "@lifecycle/contracts": ["../shared/lifecycle-contracts.ts"],
      "@lifecycle/tree": ["../shared/lifecycle-tree.ts"],
      "@st/collections": ["../shared/st-collections.ts"],
      "@st/types": ["../shared/st-types.ts"],
      "@st/signals": ["../shared/st-signals.ts"],
      "@st/order-tickets": ["../shared/st-order-tickets.ts"],
      "@st/position-groups": ["../shared/st-position-groups.ts"],
      "@st/strategy-instances": ["../shared/st-strategy-instances.ts"],
      "@screenshot-capture/contracts": ["../shared/screenshot-capture-contracts.ts"],
      "@screenshot-capture/utils": ["../shared/screenshot-capture-utils.ts"],
      "@flex-chart/theme": ["../shared/flex-chart-theme.ts"],
      "@flex-chart/scale-math": ["../shared/flex-chart-scale-math.ts"],
      "@flex-chart/indicator-visuals": ["../shared/flex-chart-indicator-visuals.ts"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "compileOnSave": true,
  "include": [
    "src",
    "scripts/backtest-qqq-underlying.ts",
    "scripts/open-close-strategy-comparison.ts",
    "scripts/seed-options-strategy-instances.ts",
    "scripts/replay-missing-symbols.ts",
    "scripts/verify/*.ts"
  ]
}
