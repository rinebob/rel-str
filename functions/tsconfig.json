{
  "compilerOptions": {
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@rh-agent-mcp/contracts": ["../shared/robinhood-mcp-contracts.ts"],
      "@rh-agent-mcp/utils": ["../shared/robinhood-mcp-utils.ts"],
      "@options-contract/contracts": ["../shared/options-contract-contracts.ts"],
      "@options/common": ["../shared/options-common.ts"],
      "@common": ["../shared/common.ts"],
      "@spread/contracts": ["../shared/spread-contracts.ts"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "compileOnSave": true,
  "include": [
    "src",
    "scripts/backtest-qqq-underlying.ts"
  ]
}
