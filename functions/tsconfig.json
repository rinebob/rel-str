{
  "compilerOptions": {
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@rh-agent-mcp/contracts": ["../shared/robinhood-mcp-contracts.ts"],
      "@rh-agent-mcp/utils": ["../shared/robinhood-mcp-utils.ts"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
