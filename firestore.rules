rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function partnerCallerEmail() {
      return "rel-str-partner-caller-prod@rel-str.iam.gserviceaccount.com";
    }
    function isPartnerCaller() {
      return request.auth != null && request.auth.token.email == partnerCallerEmail();
    }
    // DEV-ONLY: whitelist a local developer account to seed data in emulator/dev
    function isDevUser() {
      return request.auth != null && request.auth.token.email in [
        "test@user.com"
      ];
    }

    // Authenticated read of tracked symbols for UI symbol pickers (no writes)
    match /tracked-symbols/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Authenticated read of pairs-data written by backend; FE is read-only
    match /pairs-data/{pairId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-pair canonical signals (year shards with opens/closes subcollections)
      // - pairs-data/{PAIR}/signals/{YYYY}/opens/{signalId}
      // - pairs-data/{PAIR}/signals/{YYYY}/closes/{signalId}
      match /signals/{year}/{subcol}/{docId} {
        allow read: if request.auth != null && year.matches('^\\d{4}$');
        allow write: if false;
      }

      // Per-pair signals-daily (year-closed shards only)
      // - pairs-data/{PAIR}/signals-daily/{YYYY}/days/{day}
      match /signals-daily/{bucket} {
        allow read: if request.auth != null && bucket.matches('^\\d{4}$');
        allow write: if false;
        match /days/{day} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }

      // Archive: year-sharded per-day docs under dynamic collections
      // - archive-YYYY (daily)
      // - archive-weekly-YYYY (weekly)
      // - archive-monthly-YYYY (monthly)
      match /{archiveCol}/{docId} {
        allow read: if request.auth != null
          && archiveCol.matches('^(archive|archive-weekly|archive-monthly)-\\d{4}$');
        allow write: if false; // backend-only writes via functions
      }
    }

    // Symbol-level mirrors (e.g., currentPrice) written by backend; FE is read-only
    match /symbol-data/{symbolId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Year-sharded daily bars — symbol-data schema (RS-BARS-STORAGE-2607-01)
      match /daily/{year} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Flat weekly bars — single doc at weekly/all
      match /weekly/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Flat monthly bars — single doc at monthly/all
      match /monthly/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Heatmap snapshots for dashboard v3 (viewport docs), backend-written, FE read-only
    match /heatmap-snapshots/{snapshotId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Partner events (backend refresh runs) for header status
    match /partner-events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /app/refresh-status {
      allow read: if request.auth != null;
      // Allow writes from Functions SA in prod, and a dev user in local dev only
      allow create, update: if isPartnerCaller() || isDevUser();
      allow delete: if false;
    }

    // RS warning events persisted by backend for UI visibility
    match /rs-warnings/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // backend-only writes via functions
    }

    // Positions single-root open + year-closed shards
    // - positions/open/items/{id}
    // - positions/{YYYY}-closed/items/{id}
    match /positions/{bucket} {
      // legacy doc id path: positions/{id}
      allow read: if request.auth != null;
      allow write: if false;
      match /items/{id} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Root signals-daily mirror (doc-per-day only)
    // - signals-daily/{YYYY}/days/{day}
    match /signals-daily/{year} {
      allow read: if request.auth != null;
      allow write: if false;
      match /days/{day} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Authenticated user profile root: allow user to read/write only their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User lists: restrict to owner as well
      match /lists/{listId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Trade journal entries for this user
      match /trades/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Retired in #1013 (data deleted, deny-by-default — no match blocks):
    // savant-trader/data/{status,occurrence-decisions,review-list,symbol-meta,
    // symbol-lists,order-intents,trading-config}, options-strategy-*, legacy
    // portfolio/{buckets,attributions}, backtest-{runs,permutations},
    // paper-trading/{accounts,trades,stats,raw-quotes}/items, rh-agent-* data
    // roots.
    // Retired in #1159/#1019: savant-trader/data/runs (deleted at #1159 ship)
    // and savant-trader/data/symbols incl. run-ids/signal-history/signal-dates/
    // signals subcollections (readers cut to st-signals + st-symbols; root
    // deleted at #1019 ship). Deny-by-default.

    // RH Agent — production API collections (not legacy/migration)
    //
    // Encrypted RH credential bundle — KMS ciphertext written by the
    // functions SA only. No client read/write path ever; the document is
    // ciphertext but clients must not even enumerate it.
    match /rh-agent-credentials/{doc} {
      allow read, write: if false;
    }

    // Options file index — SA-written contract metadata for browser UI
    // - options-file-index/{SYMBOL}/ts-expirations/{exp}
    // - options-file-index/{SYMBOL}/ts-strikes/{strike}
    match /options-file-index/{symbol} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Screenshot-capture index — backend-written manifest index for
    // st-trade-screenshots artifacts; FE read-only for the library view.
    match /st-screenshots/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Spread runs — backend-written run docs, FE read-only
    match /spread-runs/{runId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Per-run job docs — backend-written, FE read-only
      match /jobs/{jobId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Spread lists — user-scoped CRUD
    match /spread-lists/{listId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // options-strategy-instances — retired in #1013 (superseded by
    // st-strategy-instances); intentionally no match block.

    // Paper trading — grouped {anchor}/items layout.
    // - instances anchor retired in #1013 (canonical home is
    //   st-strategy-instances); the wildcard below still covers it but no
    //   leg grants writes.
    // - analysis-slices/items: authed CRUD — saved analysis views are
    //   user-written from the workbench (#1059/#1073).
    // - analysis-datasets/items: authed update + delete — the workbench
    //   edits tags/notes and deletes datasets (#1059/#1081); create stays
    //   server-side (the generateTradeDataset callable mints index docs).
    // - all other anchors (accounts/trades/cohorts/stats/raw-quotes):
    //   authenticated read for the single-user app; writes are
    //   server-side (admin SDK bypasses rules — ledger passes and the
    //   dataset generator own all writes).
    match /paper-trading/{anchor}/items/{docId} {
      allow read: if request.auth != null;
      allow create: if
        (anchor == 'analysis-slices' && request.auth != null);
      allow update: if
        (anchor == 'analysis-slices' && request.auth != null) ||
        (anchor == 'analysis-datasets' && request.auth != null);
      allow delete: if
        (anchor == 'analysis-slices' && request.auth != null) ||
        (anchor == 'analysis-datasets' && request.auth != null);
      match /{sub}/{subDocId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ZigZag swing sets — flat collection, user-scoped CRUD under
    // st-swing-sets/{symbol}_{paramsId}
    // - List queries must constrain userId (where('userId','==',uid)) or
    //   the rules engine cannot prove every returned doc is owned — the
    //   query is denied outright. No resource == null escape hatch.
    // - Single-doc reads/writes enforce userId ownership per doc.
    match /st-swing-sets/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Swing config library — flat collection, user-scoped CRUD under
    // st-swing-configs/{paramsId}
    // Same rules shape as st-swing-sets: list queries must constrain
    // userId or the rules engine denies the query outright.
    match /st-swing-configs/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── ST canonical data plane (Topic #984 — st-* roots) ────────────────────
    // Consolidated roots replacing savant-trader/data/* and the renamed
    // backtest/paper-trading/portfolio roots. Backend writers use the admin
    // SDK (which bypasses rules); each block mirrors the policy of the legacy
    // collection it replaces.

    // st-symbols — tracked-symbol universe (was savant-trader/data/symbols).
    // Authed read for pickers/universe views; all writes are backend.
    match /st-symbols/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // st-signals — flat signal occurrences ({SYM}_{barDate}_{signalType}).
    // Authed read for gallery/review pages; writes are backend dual-write.
    match /st-signals/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // st-runs — run history + per-run jobs subcollection (was
    // savant-trader/data/runs). Authed read; writes are backend.
    match /st-runs/{runId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /jobs/{jobId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // st-order-tickets — universal ticket root (was order-intents +
    // occurrence-decisions). User-scoped CRUD; the `resource == null`
    // escape allows collection list queries — the client must filter by
    // userId (same convention as the legacy intents rule).
    match /st-order-tickets/{docId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // st-position-groups — aggregation units over ticket/trade members.
    // User-scoped read for the positions view; groups are minted and
    // stamped by backend passes only.
    match /st-position-groups/{docId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.userId);
      allow write: if false;
    }

    // st-strategy-instances — program/time-based strategy instances (was
    // options-strategy-instances). User-scoped CRUD.
    match /st-strategy-instances/{docId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // st-config — heterogeneous config root (was trading-config/* +
    // status/current). 'status' and 'autoPaper' are backend-written
    // singletons — authed read only. Remaining docs are per-user trading
    // config ({uid} doc ids) — user-scoped CRUD.
    match /st-config/{docId} {
      allow read: if request.auth != null
        && (docId in ['status', 'autoPaper']
            || resource == null
            || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // st-symbol-lists — user-scoped CRUD (was savant-trader/data/symbol-lists).
    // Same shape as the legacy rule, including the no-userId escape: a doc
    // can briefly lack the stamp while the mirror dual-write lands; clients
    // may read/delete those so the lazy rekey path keeps working.
    match /st-symbol-lists/{listId} {
      allow read: if request.auth != null && (resource == null || resource.data.get('userId', null) == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && (resource.data.get('userId', null) == null || request.auth.uid == resource.data.userId);
    }

    // st-backtest-runs / st-backtest-permutations — renamed roots (were
    // backtest-runs / backtest-permutations). Same policy: authed read;
    // the FE may only flip archived/qualityDesignation (+updatedAt) on runs.
    match /st-backtest-runs/{runId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'qualityDesignation', 'updatedAt']);
      allow delete: if false;
    }

    match /st-backtest-permutations/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // st-options-replay-runs / st-options-contract-lists — Selection Replay
    // (Topic #1238). Same policy as st-backtest-permutations: authed read,
    // backend-only writes. No user-editable fields expected in v1 (run doc is
    // cancelled via the callable, not a client write).
    match /st-options-replay-runs/{runId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /st-options-contract-lists/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // st-paper-trading — renamed anchors (accounts/trades/stats/raw-quotes
    // items). All writes are server-side (ledger passes); FE is read-only,
    // including one level of nested subcollections for future kinds.
    match /st-paper-trading/{anchor}/items/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /{sub}/{subDocId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // st-portfolio — renamed buckets/attributions anchors (was
    // portfolio/*). Same user-scoped CRUD, including the get/list split so
    // missing-doc probes inside transactions keep working (see portfolio).
    match /st-portfolio/{anchor} {
      allow read, write: if false;
      match /items/{docId} {
        allow get: if request.auth != null
          && (anchor == 'buckets' || anchor == 'attributions')
          && (resource == null || request.auth.uid == resource.data.userId);
        allow list: if request.auth != null
          && (anchor == 'buckets' || anchor == 'attributions')
          && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null
          && (anchor == 'buckets' || anchor == 'attributions')
          && request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null
          && (anchor == 'buckets' || anchor == 'attributions')
          && request.auth.uid == resource.data.userId;
      }
    }

    // Saved user configurations — authenticated CRUD, no user-scoping.
    // This is a single-user app (one developer account), so all authenticated
    // users are the owner. Path: configs/{feature-name}/configs/{configId}
    // Intermediate doc is denied; leaf docs allow authenticated read/write.
    // The wildcard {featureDoc} is intentional — any feature may store configs
    // under this root collection without adding a new rule block.
    match /configs/{featureDoc} {
      allow read: if false; // intermediate doc — no direct reads
      allow write: if false; // intermediate doc — no direct writes
      match /configs/{configId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }

    // Portfolio allocation — single `portfolio` root, per-kind anchors with
    // items subcollections (paper-trading pattern):
    // - portfolio/buckets/items/{account}_{slug}
    // - portfolio/attributions/items/{account}_{instrumentId}
    // Both anchors are user-scoped CRUD (st-swing-sets shape): list queries
    // must constrain userId (where('userId','==',uid)) or the rules engine
    // RH Scanner — anchored root for scanner records (#1098).
    // - proposals/items: authed CRUD — curation proposals are written by
    //   the scanner page's compare engine (single-user app, same pattern
    //   as analysis-slices under paper-trading).
    // - latest-runs/items: authed CRUD — per-recipe latest-run cache,
    //   written by the discovery scan paths (#1232/#1254).
    // Other anchors (e.g. future saved recipes) get read-only until their
    // own task wires write access.
    match /st-scanner/{anchor}/items/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if anchor in ['proposals', 'latest-runs'] && request.auth != null;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}