rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Trade journal artifacts: allow an authenticated user to manage
    // their own files under trades/users/{uid}/**.
    match /trades/users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Fallback rule: other paths remain read-only to authenticated clients,
    // and writes are restricted to backend Functions (service account).
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
